{
  "name": "kong-manager",
  "private": true,
  "version": "0.0.0.0",
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "install:e2e": "pnpm install --filter playwright-tests",
    "test:e2e": "pnpm --filter playwright-tests run test",
    "playwright": "pnpm --filter playwright-tests exec playwright",
    "audit:prune-exclude": "node scripts/prune-min-release-age-exclude.mjs",
    "preview": "vite build && vite preview",
    "lint": "pnpm lint:eslint && pnpm lint:vue && pnpm lint:playwright && pnpm lint:style",
    "lint:eslint": "eslint src tests/playwright",
    "lint:eslint:fix": "eslint --fix src tests/playwright",
    "lint:playwright": "tsc --noEmit --project tests/playwright/tsconfig.json --baseUrl tests/playwright",
    "lint:style": "stylelint --allow-empty-input 'src/**/*.{css,scss,sass,less,styl,vue}'",
    "lint:vue": "vue-tsc --noEmit",
    "postinstall": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,js,vue}": "eslint --fix",
    "src/**/*.{css,scss,sass,less,styl,vue}": "stylelint --allow-empty-input --fix 'src/**/*.{css,scss,sass,less,styl,vue}'"
  },
  "dependencies": {
    "@kong-ui-public/app-layout": "^4.13.18",
    "@kong-ui-public/entities-certificates": "^3.16.36",
    "@kong-ui-public/entities-consumer-credentials": "^3.10.31",
    "@kong-ui-public/entities-consumers": "^4.7.28",
    "@kong-ui-public/entities-gateway-services": "^3.27.8",
    "@kong-ui-public/entities-key-sets": "^3.13.31",
    "@kong-ui-public/entities-keys": "^3.15.31",
    "@kong-ui-public/entities-plugins": "9.268.3",
    "@kong-ui-public/entities-plugins-metadata": "^1.16.0",
    "@kong-ui-public/entities-routes": "3.26.24",
    "@kong-ui-public/entities-shared": "^3.66.0",
    "@kong-ui-public/entities-snis": "^3.14.31",
    "@kong-ui-public/entities-upstreams-targets": "^3.16.31",
    "@kong-ui-public/entities-vaults": "^4.16.33",
    "@kong-ui-public/forms": "4.33.33",
    "@kong-ui-public/i18n": "^2.5.1",
    "@kong-ui-public/misc-widgets": "^2.5.10",
    "@kong-ui-public/monaco-editor": "^0.24.17",
    "@kong/icons": "^1.62.1",
    "@kong/kongponents": "9.64.12",
    "@material-design-icons/font": "^0.14.13",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "monaco-editor": "0.52.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@kong/design-tokens": "^3.3.1",
    "@kong/eslint-config-kong-ui": "^1.7.1",
    "@kong/stylelint-plugin-design-tokens": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.4.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/devtools-api": "^8.2.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.20",
    "bmp-js": "^0.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-vuejs-accessibility": "^2.3.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "lodash-es": "^4.18.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.80.3",
    "stylelint": "^16.9.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^3.3.11"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not IE <= 11"
  ],
  "packageManager": "pnpm@11.10.0"
}
